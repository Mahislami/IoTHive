        {
          "datasource": {
            "type": "influxdb",
            "uid": "e87c7d47-de3d-43a7-8ecc-c91b3789d586"
          },
          "query": "import \"array\"\nimport \"strings\"\n\nkitchen = from(bucket: \"iot_bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\")\n  |> filter(fn: (r) => r.topic =~ /^iot\\/power\\/(dishwasher|washing_machine|dryer|oven|microwave|kettle|gas|fridge|tv)\\//)\n  |> filter(fn: (r) => r._field == \"power_w\" or r._field == \"status\" or r._field == \"mode\" or r._field == \"cycle\" or r._field == \"cycle_progress\" or r._field == \"timer_status\" or r._field == \"timer_remaining_seconds\")\n  |> group(columns: [\"topic\", \"_field\"])\n  |> last()\n  |> pivot(rowKey: [\"topic\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => {\n      trimmed = strings.trimPrefix(v: r.topic, prefix: \"iot/power/\")\n      parts = strings.split(v: trimmed, t: \"/\")\n      t = if array.length(a: parts) >= 1 then array.get(a: parts, idx: 0) else \"\"\n      id = if array.length(a: parts) >= 2 then array.get(a: parts, idx: 1) else \"\"\n      return { r with device_type: t, device_id: id }\n  })\n\nkitchen",
          "refId": "A"
        }
      ],
      "title": "Kitchen Appliance State",
      "transformations": [],
      "type": "table"
    },
